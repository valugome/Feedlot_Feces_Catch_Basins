top_negative_fold_changes_cDNA <- DA_cDNA_pathways_together %>%
filter(!is.na(test)) %>%
# get the max coef per pathway for ordering
group_by(pathway) %>%
mutate(max_coef = max(coef, na.rm = TRUE)) %>%
ungroup() %>%
arrange(desc(max_coef), pathway, test) %>%
tail(n = 8) #top 4
top_negative_fold_changes_cDNA
